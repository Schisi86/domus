{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusTalk",
  "version": "0.1.0",
  "identifier": "org.nexustalk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: mediastream:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "NexusTalk",
    "copyright": "MIT License",
    "category": "SocialNetworking",
    "shortDescription": "Schlanke, selbst hostbare Kommunikationssoftware",
    "longDescription": "NexusTalk: Text-, Sprach- und Bildschirmübertragung mit eigenem Server – ohne Cloud-Zwang.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
