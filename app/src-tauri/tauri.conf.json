{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Domus",
  "mainBinaryName": "Domus",
  "version": "1.0.2",
  "identifier": "org.nexustalk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: mediastream: https: http:; connect-src 'self' blob: ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src https://www.youtube-nocookie.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Christian Schiessl",
    "copyright": "© 2026 Christian Schiessl",
    "category": "SocialNetworking",
    "shortDescription": "Domus – dein eigener Server für Text, Sprache und Video. Von Christian Schiessl",
    "longDescription": "Domus (vormals NexUs und NexusTalk): Text, Sprache, Video und Bildschirmübertragung mit eigenem Server – ohne Cloud-Zwang. © 2026 Christian Schiessl · https://cjs86.netlify.app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": "de-DE"
      }
    },
    "homepage": "https://domus-talk.netlify.app",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "macos/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 170,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 215
        }
      }
    }
  }
}
